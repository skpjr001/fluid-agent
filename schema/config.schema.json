{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/skpjr001/fluid-agent/main/schema/config.schema.json",
  "title": "fluid-agent static config",
  "description": "Read once at startup (config.json).",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Path or URL of the JSON Schema for editor validation."
    },
    "proxy_addr": {
      "type": "string",
      "default": ":8080",
      "description": "Forward proxy + /forward listener."
    },
    "webhook_addr": {
      "type": "string",
      "default": ":8081",
      "description": "Public webhook and ingest listener."
    },
    "admin_addr": {
      "type": "string",
      "default": "127.0.0.1:9000",
      "description": "Admin API and UI listener; keep on localhost."
    },
    "proxy_base_path": {
      "description": "Path prefix for POST /forward and /healthz on the proxy listener, e.g. \"/relay\". Requests work with or without the prefix, so the reverse proxy may strip it or not.",
      "type": "string",
      "pattern": "^((/[A-Za-z0-9._~-]+)+/?|/?)$"
    },
    "webhook_base_path": {
      "description": "Path prefix for webhooks, ingest and health endpoints, e.g. \"/hooks-gw\". Requests work with or without the prefix, so the reverse proxy may strip it or not.",
      "type": "string",
      "pattern": "^((/[A-Za-z0-9._~-]+)+/?|/?)$"
    },
    "admin_base_path": {
      "description": "Path prefix for the console and API, e.g. \"/fluid-admin\". Empty: taken from X-Forwarded-Prefix sent by a trusted proxy. Requests work with or without the prefix, so the reverse proxy may strip it or not.",
      "type": "string",
      "pattern": "^((/[A-Za-z0-9._~-]+)+/?|/?)$"
    },
    "proxy_tls": {
      "$ref": "#/$defs/tls",
      "description": "Serve the proxy over HTTPS (clients use https:// proxy URLs). HTTP/1.1 only."
    },
    "webhook_tls": {
      "$ref": "#/$defs/tls",
      "description": "Serve webhooks and ingest over HTTPS without a reverse proxy."
    },
    "admin_tls": {
      "$ref": "#/$defs/tls",
      "description": "Serve the console and API over HTTPS."
    },
    "dynamic_dir": {
      "type": "string",
      "default": "./dynamic",
      "description": "Directory of hot-reloaded JSON files."
    },
    "reload_interval": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Go duration string, e.g. \"30s\", \"5m\"."
    },
    "max_conns": {
      "type": "integer",
      "minimum": 1,
      "default": 2000,
      "description": "Concurrent proxy requests/tunnels."
    },
    "max_body_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 10485760,
      "description": "Max inbound body size."
    },
    "trusted_proxies": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "description": "IP address or CIDR, e.g. \"52.66.0.0/16\"."
      },
      "description": "Reverse proxies whose X-Forwarded-For is believed (walked right to left)."
    },
    "tunnel_idle_timeout": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Go duration string, e.g. \"30s\", \"5m\"."
    },
    "shutdown_timeout": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Graceful shutdown (SIGTERM/SIGINT): time to finish in-flight requests, CONNECT tunnels and deliveries before they are closed (unfinished deliveries are requeued, not lost). Container stop timeouts must be longer. Default 15s."
    },
    "shutdown_delay": {
      "type": "string",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "description": "Keep serving this long after SIGTERM while /readyz reports draining (503), so load balancers stop sending first. Default 0s."
    },
    "webhook_rate_limit": {
      "$ref": "#/$defs/rateLimit"
    },
    "forward": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "description": "Max upstream response size."
        },
        "max_redirects": {
          "type": "integer",
          "minimum": 0,
          "description": "Redirects followed (each re-checked)."
        },
        "default_timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Go duration string, e.g. \"30s\", \"5m\"."
        },
        "max_timeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Go duration string, e.g. \"30s\", \"5m\"."
        }
      },
      "description": "JSON /forward relay settings."
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "SQLite file."
        },
        "retention_days": {
          "type": "integer",
          "minimum": 1,
          "description": "Days to keep logs, events and finished deliveries."
        },
        "log_level": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ],
          "description": "Minimum level stored."
        },
        "store_event_bodies": {
          "type": "boolean",
          "description": "Keep bodies after delivery (shown in the UI)."
        },
        "capture_payloads": {
          "type": "boolean",
          "description": "Store the full request and response (headers and bodies) of every logged API call: inbound webhooks/ingest, deliveries, /forward and plain-HTTP proxy requests (HTTPS tunnels: the CONNECT exchange only). Stored raw; viewer tokens see credential values masked, editors see everything. Default true."
        },
        "capture_max_body_bytes": {
          "type": "integer",
          "minimum": 0,
          "description": "Maximum bytes stored per captured body (the full size is recorded either way). 0 stores headers only. Default 10485760 (10 MiB)."
        }
      },
      "description": "SQLite storage."
    },
    "outbox": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "workers": {
          "type": "integer",
          "minimum": 1,
          "description": "Concurrent background deliveries."
        },
        "poll_interval": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Go duration string, e.g. \"30s\", \"5m\"."
        },
        "max_backoff": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
          "description": "Go duration string, e.g. \"30s\", \"5m\"."
        }
      },
      "description": "Durable delivery queue."
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "otlp_endpoint": {
          "type": "string",
          "description": "OTLP/HTTP base URL, e.g. http://otel-collector:4318. Empty disables tracing."
        },
        "service_name": {
          "type": "string",
          "description": "service.name resource attribute."
        },
        "sample_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Fraction of new traces sampled."
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Headers sent to the collector."
        }
      },
      "description": "OpenTelemetry tracing."
    }
  },
  "$defs": {
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requests_per_minute": {
          "type": "integer",
          "minimum": 0,
          "description": "Sustained requests per minute per source IP; 0 disables."
        },
        "burst": {
          "type": "integer",
          "minimum": 0,
          "description": "Bucket size (requests allowed at once)."
        }
      },
      "description": "Token-bucket rate limit per source IP."
    },
    "tls": {
      "type": "object",
      "additionalProperties": false,
      "description": "HTTPS for a listener: certificate files (reloaded when they change) or automatic ACME certificates.",
      "properties": {
        "cert_file": {
          "description": "PEM certificate chain.",
          "type": "string"
        },
        "key_file": {
          "description": "PEM private key.",
          "type": "string"
        },
        "acme": {
          "type": "object",
          "additionalProperties": false,
          "description": "Automatic certificates (Let's Encrypt by default). TLS-ALPN-01 needs the listener on :443; otherwise set http_challenge_addr.",
          "properties": {
            "domains": {
              "description": "Hostnames to obtain certificates for.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "minItems": 1
            },
            "email": {
              "description": "Contact email for the CA account.",
              "type": "string"
            },
            "cache_dir": {
              "description": "Where certificates and the account key are kept. Default: <database dir>/acme.",
              "type": "string"
            },
            "directory_url": {
              "description": "ACME directory, e.g. Let's Encrypt staging. Default: Let's Encrypt production.",
              "type": "string"
            },
            "ca_file": {
              "description": "PEM roots to trust for the ACME directory (private ACME servers such as step-ca or Pebble).",
              "type": "string"
            },
            "http_challenge_addr": {
              "description": "Listener for HTTP-01 challenges, e.g. \":80\"; it also redirects other HTTP requests to HTTPS.",
              "type": "string"
            },
            "accept_tos": {
              "description": "Must be true: you accept the certificate authority's terms of service.",
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "domains",
            "accept_tos"
          ]
        },
        "min_version": {
          "description": "Minimum TLS version.",
          "enum": [
            "1.2",
            "1.3"
          ]
        }
      },
      "oneOf": [
        {
          "required": [
            "cert_file",
            "key_file"
          ],
          "not": {
            "required": [
              "acme"
            ]
          }
        },
        {
          "required": [
            "acme"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "cert_file"
                ]
              },
              {
                "required": [
                  "key_file"
                ]
              }
            ]
          }
        }
      ]
    }
  }
}
