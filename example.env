# Environment for fluid-agent. Copy it and fill it in:
#   Docker Compose:  cp example.env .env           (compose.yml reads .env)
#   systemd:         /etc/fluid-agent/agent.env    (enable EnvironmentFile= in the unit, chmod 600)
# Never commit the filled-in copy: .env is git-ignored.

# Extra editor token for the console and admin API, on top of dynamic/admin.json.
# At least 16 characters; generate one with: openssl rand -hex 32
# Required by compose.yml. Optional elsewhere: when it is set on the first start,
# the generated admin.json holds no token of its own.
PROXY_ADMIN_TOKEN=

# Export OpenTelemetry traces over OTLP/HTTP (same as telemetry.otlp_endpoint
# in config.json, which wins when both are set). Empty: no tracing.
OTEL_EXPORTER_OTLP_ENDPOINT=
