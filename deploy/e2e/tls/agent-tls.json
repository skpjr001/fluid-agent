{
  "$schema": "../../../schema/config.schema.json",
  "proxy_addr": ":8080",
  "webhook_addr": ":8081",
  "admin_addr": ":9000",
  "admin_base_path": "/console",
  "dynamic_dir": "/app/dynamic",
  "proxy_tls": {"cert_file": "/certs/tls.crt", "key_file": "/certs/tls.key"},
  "webhook_tls": {"cert_file": "/certs/tls.crt", "key_file": "/certs/tls.key"},
  "admin_tls": {"cert_file": "/certs/tls.crt", "key_file": "/certs/tls.key", "min_version": "1.3"},
  "database": {"path": "/app/data/tls.db", "retention_days": 1, "log_level": "info", "store_event_bodies": true}
}
