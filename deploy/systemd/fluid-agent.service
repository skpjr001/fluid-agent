# /etc/systemd/system/fluid-agent.service
#   sudo useradd -r -s /usr/sbin/nologin -d /var/lib/fluid-agent fluid
#   sudo install -m 755 fluid-agent /usr/local/bin/
#   sudo systemctl enable --now fluid-agent
#
# systemd creates /var/lib/fluid-agent (StateDirectory, owned by fluid) and the
# agent creates everything inside it on first start:
#   /var/lib/fluid-agent/config.json      static config with every default spelled out
#   /var/lib/fluid-agent/dynamic/         proxy.json, admin.json (generated editor token), webhooks/ ingest/ profiles/
#   /var/lib/fluid-agent/data/            SQLite database (and acme/ certificate cache)
# Sign in with the token from: sudo cat /var/lib/fluid-agent/dynamic/admin.json
[Unit]
Description=fluid-agent relay (forward proxy, webhooks, callback ingest)
Documentation=https://github.com/skpjr001/fluid-agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fluid
Group=fluid
StateDirectory=fluid-agent
StateDirectoryMode=0750
WorkingDirectory=/var/lib/fluid-agent
# init creates anything missing and refuses to start on invalid config files.
ExecStartPre=/usr/local/bin/fluid-agent init -config /var/lib/fluid-agent/config.json
ExecStart=/usr/local/bin/fluid-agent serve -config /var/lib/fluid-agent/config.json
# Optional extra editor token (with it set, the generated admin.json holds no token):
# EnvironmentFile=-/etc/fluid-agent/agent.env
Restart=always
RestartSec=3
LimitNOFILE=65536

# Hardening: the agent only writes to its StateDirectory (config, API edits, database).
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
# Built-in TLS on :443/:80 (webhook_tls / acme.http_challenge_addr)? Replace the line above with:
# CapabilityBoundingSet=CAP_NET_BIND_SERVICE
# AmbientCapabilities=CAP_NET_BIND_SERVICE
SystemCallArchitectures=native
UMask=0027

[Install]
WantedBy=multi-user.target
